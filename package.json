{
  "name": "pi-ext-opencode-zen",
  "version": "1.0.0",
  "description": "Pi extension for OpenCode Zen provider - Zen-authoritative model registry with models.dev enrichment",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npx --yes tsx@4.20.6 --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "test:matrix": "node test/release-matrix.mjs"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@juanibiapina/pi-extension-settings": "*"
  },
  "peerDependenciesMeta": {
    "@juanibiapina/pi-extension-settings": {
      "optional": true
    },
    "@mariozechner/pi-coding-agent": {
      "optional": true
    }
  },
  "keywords": [
    "pi-package",
    "pi",
    "extension",
    "opencode",
    "llm",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@mariozechner/pi-ai": "latest",
    "@mariozechner/pi-coding-agent": "latest",
    "typescript": "5.9.3"
  }
}
